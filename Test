    elseif cmd == "carfling" and arg ~= "" then
        _G.cancelCarKill = false
        repeat if stopkick then stopkick = false; break end task.spawn(kick2, arg); task.wait(0.5) until not findpl(arg)
    elseif cmd == "carkill" and arg ~= "" then
        _G.cancelCarKill = false
        repeat if stopkill then stopkill = false; break end task.spawn(kfl, arg); task.wait(1) until not findpl(arg).Character:FindFirstChild('HumanoidRootPart')
    elseif (cmd == "instantkill" or cmd == "ikill") and arg ~= "" then _G.cancelInstaKill = false; task.spawn(ikill, arg)
    elseif (cmd == 'advancedview' or cmd == 'aview') and arg ~= "" then task.spawn(aview, arg)
    elseif cmd == 'stopfling' then stopkick = true; _G.cancelCarKill = true
    elseif cmd == 'stopkill' then stopkill = true
    elseif cmd == 'invisguns' then task.spawn(invisguns)
    elseif cmd == 'uninvisguns' then task.spawn(uninvisguns)
    elseif (cmd == "carexplode" or cmd == "cexplode") and arg ~= "" then _G.cancelExplode = false; task.spawn(explode, arg)
    elseif cmd == "pp" then task.spawn(pp)
    elseif cmd == "walkspeed" or cmd == "speed" then local n = tonumber(arg); if n then gethm().WalkSpeed = n end
    elseif cmd == "jumpheight" or cmd == "jumph" then local n = tonumber(arg); if n then gethm().JumpHeight = n end
    elseif cmd == "fov" then local n = tonumber(arg); if n then workspace.CurrentCamera.FieldOfView = n end
    elseif cmd == "autoreload" then task.spawn(autoreload)
    elseif cmd == "unautoreload" then unautoreload()
    elseif cmd == "hotswap" or cmd == "autoswap" then hotswapbool = true
    elseif cmd == "unhotswap" or cmd == "unautoswap" then hotswapbool = false
    elseif cmd == "invisible" then task.spawn(invisible)
    elseif cmd == "uninvisible" then uninvisible()
