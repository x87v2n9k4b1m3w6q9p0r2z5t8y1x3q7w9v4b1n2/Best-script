local function runcommand(msg, frombar)
    msg = msg:lower():match("^%s*(.-)%s*$")
    if not msg or msg == "" then return end
    local pfx = msg:sub(1, 1)
    if not frombar and not (pfx == ":" or pfx == ";" or pfx == "!" or pfx == "?" or pfx == "/" or pfx == ".") then return end
    if pfx == ":" or pfx == ";" or pfx == "!" or pfx == "?" or pfx == "/" or pfx == "." then
        msg = msg:sub(2):match("^%s*(.-)%s*$")
    end
    local cmd, arg = msg:match("^(%S+)%s*(.-)$")
    if not cmd then return end
    cmd = cmd:lower(); arg = arg or ""
    if cmd == "noclip" then task.spawn(noclip)
    elseif cmd == "unnoclip" or cmd == "clip" then unnoclip()
    elseif cmd == "infstamina" or cmd == "infstam" then task.spawn(infstam)
    elseif cmd == "criminal" or cmd == "crim" then crim()
    elseif cmd == "autorespawn" or cmd == "autore" then task.spawn(autore)
    elseif cmd == "unautore" then autorebool = false
    elseif cmd == "ak47" then task.spawn(ak47)
    elseif cmd == "remington" or cmd == "rem" then task.spawn(shotgun)
    elseif cmd == "autoguns" then task.spawn(autog)
    elseif cmd == "unautoguns" then autogbool = false
    elseif cmd == "hammer" then task.spawn(hammer)
    elseif cmd == "knife" then task.spawn(knife)
    elseif cmd == "bomb" then task.spawn(getb)
    elseif cmd == "fal" then task.spawn(getf)
    elseif cmd == "base" then base()
    elseif cmd == "yard" then yard()
    elseif cmd == "prison" then prison()
    elseif cmd == "caf" or cmd == "cafeteria" then cafeteria()
    elseif cmd == "tower" then tower()
    elseif cmd == "armory" then armory()
    elseif cmd == "removedoors" or cmd == "rdoors" then rdoors()
    elseif cmd == "infjump" then infjump()
    elseif cmd == "uninfjump" then infjumpbool = false; if infjumpconn then infjumpconn:Disconnect() end
    elseif cmd == "car" then task.spawn(car)
    elseif cmd == "carwalk" then task.spawn(carwalk)
    elseif cmd == "fly" then fly(true)
    elseif cmd == "unfly" then fly(false)
    elseif cmd == "wallbang" then wallbang()
    elseif cmd == "unwallbang" then unwallbang()
    elseif cmd == "nuke" then nuke()
    elseif cmd == "antishield" then ashield()
    elseif cmd == "unantishield" then stopshield()
    elseif cmd == "view" and arg ~= "" then view(arg)
    elseif cmd == "unview" then unview()
    elseif cmd == "goto" or cmd == "to" then if arg ~= "" then tpToPlayer(arg) end
    elseif cmd == "boost" then boosting = true; task.spawn(function() while boosting do local hm = gethm(); if hm then hm.WalkSpeed = 30; hm.JumpHeight = 30 end; task.wait() end end)
    elseif cmd == "unboost" then boosting = false; local hm = gethm(); if hm then hm.WalkSpeed = 16; hm.JumpHeight = 5.5 end
    elseif cmd == "esp" then espstart()
    elseif cmd == "unesp" then espstop()
    elseif cmd == "silentaim" then silent()
    elseif cmd == "autoshoot" then toggleAutoShoot(true)
    elseif cmd == "unautoshoot" then toggleAutoShoot(false)
    elseif cmd == "antitase" then antits()
    elseif cmd == "unantitase" then if antitasebool then antits() end
    elseif cmd == "arrest" and arg ~= "" then _G.cancelArrest = false; task.spawn(arrest, arg)
    elseif cmd == "kill" and arg ~= "" then _G.cancelMeleeKill = false; task.spawn(kill, arg)
    elseif cmd == "bring" and arg ~= "" then _G.cancelBring = false; task.spawn(bring, arg)
