    elseif cmd == "unnospread" then nospreadbool = false; applyAllGunMods()
    elseif cmd == "automatic" or cmd == "fullauto" then automaticbool = true; applyAllGunMods(); startGunModLoop()
    elseif cmd == "unautomatic" then automaticbool = false; applyAllGunMods()
    end
end

