        local gun = nil
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and (tool:GetAttribute("FireRate") or tool:GetAttribute("Local_CurrentAmmo") ~= nil) then
                gun = tool
                break
            end
        end
        
        if not gun then return end
        
        -- Tenta disparar usando o evento de tiro do Prison Life
        local shootEvent = storage:FindFirstChild("GunRemotes") and storage.GunRemotes:FindFirstChild("ShootEvent")
        if not shootEvent then
            shootEvent = storage:FindFirstChild("ShootEvent")
        end
        
        if shootEvent then
            -- Prepara a tabela de tiro (similar ao que outros scripts fazem)
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and gun:FindFirstChild("Handle") then
                local origin = gun.Handle.Position
                local direction = workspace.CurrentCamera.CFrame.LookVector
                local targetPos = origin + (direction * 1000)
                
                pcall(function()
                    shootEvent:FireServer({{Vector3.new(targetPos.X, targetPos.Y, targetPos.Z), Vector3.new(origin.X, origin.Y, origin.Z), hrp}})
                end)
            end
        end
    end
    
    -- Loop de disparo
    autoShootConn = run.Heartbeat:Connect(function()
        if not autoShootEnabled then return end
        shoot()
    end)
    
    notify("AutoShoot", "Enabled", 3, "success")
end

local function stopAutoShoot()
    autoShootEnabled = false
    if autoShootConn then
        autoShootConn:Disconnect()
        autoShootConn = nil
    end
    notify("AutoShoot", "Disabled", 3)
end

local function toggleAutoShoot(state)
    if state then
        startAutoShoot()
    else
        stopAutoShoot()
    end
end

