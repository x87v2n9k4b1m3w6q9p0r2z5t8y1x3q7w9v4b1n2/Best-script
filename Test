local function updateesp()
    if not espbool then return end
    local ch = localp.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for plr, d in pairs(esp) do
        local target = plr.Character
        local tr = target and target:FindFirstChild("HumanoidRootPart")
        local hm = target and target:FindFirstChildOfClass("Humanoid")
        local head = target and target:FindFirstChild("Head")
        if not target or target ~= d.character or not tr or not hm or not head then
            createesp(plr)
        else
            local color = espcolor(plr)
            if d.highlight then
                d.highlight.FillColor = color; d.highlight.OutlineColor = color
            end
            if d.billboard then
                d.billboard.Adornee = head
                local text = ""
                if espSettings.Name then text = text .. plr.DisplayName .. "\n" end
                if espSettings.Health then text = text .. "HP: " .. math.floor(hm.Health) .. "\n" end
                if espSettings.Distance then text = text .. "Dist: " .. math.floor((root.Position - tr.Position).Magnitude) .. "m" end
                d.text.Text = text
                d.text.TextColor3 = color
            end
            if d.box then
                d.box.Size = target:GetExtentsSize()
                d.box.Color3 = color
            end
            if d.tracer and d.tracer.Parent then
                local pos, onScreen = cam:WorldToViewportPoint(tr.Position)
                if onScreen then
                    d.tracer.Visible = true
                    local screenPos = Vector2.new(pos.X, pos.Y)
                    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
                    local dist = (screenPos - center).Magnitude
                    local angle = math.atan2(screenPos.Y - center.Y, screenPos.X - center.X)
                    d.tracer.Position = UDim2.new(0.5, 0, 1, 0)
                    d.tracer.Size = UDim2.new(0, 1, 0, dist)
                    d.tracer.Rotation = math.deg(angle) + 90
                    d.tracer.BackgroundColor3 = color
                else
                    d.tracer.Visible = false
                end
            end
        end
    end
end

